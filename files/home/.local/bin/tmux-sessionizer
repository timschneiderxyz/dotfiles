#!/bin/zsh

if [[ $# -eq 1 ]]; then
  selected=$1
else
  [[ -n $TMUX ]] && current_session=$(tmux display-message -p '#S')
  selected=$({
    tmux list-sessions -F "[SESSION] #{session_name}" 2>/dev/null |
      rg -vFx "[SESSION] $current_session"
    fd --base-directory "$HOME/Projects" --exact-depth 2 --type d --format '{}' .
  } | fzf)
  [[ -n $selected && $selected != "[SESSION] "* ]] && selected="$HOME/Projects/$selected"
fi

[[ -z $selected ]] && exit 0

if [[ $selected == "[SESSION] "* ]]; then
  selected_name=${selected#"[SESSION] "}
else
  selected_name=$(basename "$selected" | tr . _)
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"

  if [[ -f "$selected/.tmux-sessionizer" ]]; then
    zsh "$selected/.tmux-sessionizer" "$selected_name" "$selected"
  else
    tmux rename-window -t "$selected_name:1" main
    tmux split-window -v -l 25% -t "$selected_name:1" -c "$selected"
    tmux select-pane -t "$selected_name:1.1"
    tmux new-window -t "$selected_name:2" -c "$selected"
    tmux select-window -t "$selected_name:1"
  fi
fi

if [[ -z $TMUX ]]; then
  tmux attach-session -t "$selected_name"
else
  tmux switch-client -t "$selected_name"
fi
