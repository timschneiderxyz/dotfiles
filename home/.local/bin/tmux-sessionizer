#!/bin/zsh

# Target from the argument or picker of running sessions and projects.
if [[ $# -eq 1 ]]; then
  target=$1
else
  [[ -n $TMUX ]] && current_session=$(tmux display-message -p '#S')
  sessions=(${(f)"$(tmux list-sessions -F '#{session_name}' 2>/dev/null)"})
  sessions=(${sessions:#"$current_session"})
  projects=(${(f)"$(fd --base-directory "$HOME/Projects" --exact-depth 2 --type d --format '{}' .)"})
  projects=(${projects:|sessions})

  target=$(
    session_list=${(F)${sessions/#/"[SESSION] "}} \
    project_list=${(F)projects} \
    fzf --no-sort \
      --bind 'start,change:reload(printf %s "$session_list" | fzf --filter={q}; printf %s "$project_list" | fzf --filter={q} || true)' \
      </dev/null
  )
  [[ -n $target && $target != "[SESSION] "* ]] && target="$HOME/Projects/$target"
fi

# Nothing picked.
[[ -z $target ]] && exit 0

# Derive the session name.
if [[ $target == "[SESSION] "* ]]; then
  session_name=${target#"[SESSION] "}
elif [[ $target == "$HOME/Projects/"* ]]; then
  session_name=$(echo "${target#"$HOME/Projects/"}" | tr . _)
else
  session_name=$(basename "$target" | tr . _)
fi

# Create the session if it doesn't exist yet.
if ! tmux has-session -t="$session_name" 2>/dev/null; then
  tmux new-session -ds "$session_name" -c "$target"
fi

# Attach from outside tmux, switch from inside.
if [[ -z $TMUX ]]; then
  tmux attach-session -t "$session_name"
else
  tmux switch-client -t "$session_name"
fi
