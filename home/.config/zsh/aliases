# Common
alias \
  ..="cd .." \
  ...="cd ../.." \
  ....="cd ../../.." \
  ls="eza --icons=auto --group-directories-first --all --long --header --group" \
  lt="eza --icons=auto --group-directories-first --all --long --header --group --git --tree --level=2" \
  ff="fzf --preview 'bat --style=numbers --color=always {}'" \
  cat="bat" \
  mkd="mkdir -vp" \
  cp="cp -vi" \
  mv="mv -vi" \
  rm="grm -vI"

# Apps
alias \
  v="nvim" \
  g="git" \
  d="docker" \
  pn="pnpm"

# Utilities
alias \
  update="brew update; brew upgrade; brew autoremove; brew cleanup; mise self-update; mise upgrade; mise prune; zinit update --all; zinit cclear" \
  rmdsstore="fd --hidden --no-ignore --type f --glob '.DS_Store' --exec-batch rm -v"
sshkg() {ssh-keygen -t ed25519 -C $1 -f ~/.ssh/$2}
